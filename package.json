{
  "name": "indelible",
  "version": "0.3.4",
  "description": "Client library for the Indelible Standard — attest, verify, delegate, and prove quotes from on-chain content attestations.",
  "type": "module",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./utils": {
      "types": "./types/utils.d.ts",
      "default": "./src/utils.js"
    },
    "./verify": {
      "types": "./types/verify.d.ts",
      "default": "./src/verify.js"
    },
    "./publish": {
      "types": "./types/publish.d.ts",
      "default": "./src/publish.js"
    },
    "./constants": {
      "types": "./types/constants.d.ts",
      "default": "./src/constants.js"
    },
    "./chains": {
      "types": "./types/chains.d.ts",
      "default": "./src/chains.js"
    },
    "./ens": {
      "types": "./types/ens.d.ts",
      "default": "./src/ens.js"
    },
    "./abi/taanq": "./src/abi/taanqAbi.json",
    "./abi/ens": "./src/abi/ensAbi.json"
  },
  "files": [
    "src",
    "types",
    "README.md"
  ],
  "scripts": {
    "build:types": "tsc",
    "prepublishOnly": "npm run build:types"
  },
  "keywords": [
    "indelible",
    "attestation",
    "ethereum",
    "ens",
    "merkle",
    "ipfs",
    "viem"
  ],
  "license": "MIT",
  "peerDependencies": {
    "viem": "^2.35.0"
  },
  "dependencies": {
    "@openzeppelin/merkle-tree": "^1.0.8",
    "multiformats": "^13.4.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/indelible-world/indelible-module"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
